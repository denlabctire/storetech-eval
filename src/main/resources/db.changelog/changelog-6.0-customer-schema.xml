<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="customer-1" author="system">
        <createTable tableName="customer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="auto_pay_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="customer-2" author="system">
        <createTable tableName="customer_credit_card">
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_customer_credit_card"
                             references="customer(id)"/>
            </column>
            <column name="credit_card_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="customer-3" author="system">
        <insert tableName="customer">
            <column name="id" value="1"/>
            <column name="first_name" value="Jane"/>
            <column name="last_name" value="Doe"/>
            <column name="auto_pay_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="customer_credit_card">
            <column name="customer_id" value="1"/>
            <column name="credit_card_id" value="CC-1111-2222-3333"/>
        </insert>

        <insert tableName="customer">
            <column name="id" value="2"/>
            <column name="first_name" value="John"/>
            <column name="last_name" value="Smith"/>
            <column name="auto_pay_enabled" valueBoolean="false"/>
        </insert>

        <insert tableName="customer">
            <column name="id" value="3"/>
            <column name="first_name" value="Alex"/>
            <column name="last_name" value="Taylor"/>
            <column name="auto_pay_enabled" valueComputed="NULL"/>
        </insert>
    </changeSet>

</databaseChangeLog>
